# Copy this file to keystore.properties (same folder as settings.gradle) after you create your keystore.
# keystore.properties is git-ignored. NEVER share the .jks file or these passwords, and back them up: losing the upload key is painful.
storeFile=keystore/hush-upload.jks
storePassword=CHANGE_ME
keyAlias=hush
keyPassword=CHANGE_ME
