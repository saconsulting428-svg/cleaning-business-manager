<resources>
    <style name="Theme.Hush" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/hush_black</item>
        <item name="android:colorBackground">@color/hush_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Android 12+ splash screen: black background with the app icon -->
        <item name="android:windowSplashScreenBackground">@color/hush_black</item>
    </style>
</resources>
